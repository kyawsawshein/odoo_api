# ── Frontend environment variables ───────────────────────────────────
# Local dev:   cp sku_check_web/.env.example sku_check_web/.env
# Vercel:      set these in Vercel Dashboard → Settings → Environment Variables
#
# The values below are build-time only (VITE_ prefix).
# They are NOT secrets — they get bundled into the JS output.

# ── Backend API URL ──────────────────────────────────────────────────
# Dev (default):    empty → Vite proxy handles /api/v1/* → localhost:8000
# Vercel separate:  absolute URL of the deployed FastAPI backend
# Vercel monorepo:  empty → same origin, API served by api/index.py
VITE_API_BASE_URL=

# ── Gateway API credentials (used to fetch the JWT for protected routes)
VITE_API_USER=admin
VITE_API_PASSWORD=admin
VITE_API_CLIENT_ID=admin
